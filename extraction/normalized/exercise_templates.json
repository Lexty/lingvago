{
  "_meta": {
    "description": "Exercise-type taxonomy harvested from units 1-2 (livro + caderno). Each type = a generator the app can use to produce many items. 'needs_audio' marks the open audio question.",
    "units": [1, 2]
  },
  "types": [
    {
      "id": "match",
      "label": "Correspondência (colunas)",
      "skill": ["recognition"],
      "generatable": true, "needs_audio": false,
      "example": { "left": ["Quem é ela?", "Como se chama?"], "right": ["É a Rita.", "Chamo-me Nuno."] },
      "origins": ["livro:u1:E", "caderno:u1:A"]
    },
    {
      "id": "gap-wordbank",
      "label": "Completar com palavras da caixa",
      "skill": ["vocab", "syntax"],
      "generatable": true, "needs_audio": false,
      "example": { "bank": ["como","sim","é","está","tu","te","bem"], "item": "Olá! Como ___?", "answer": "está" },
      "origins": ["livro:u1:F", "livro:u2:C,D", "caderno:u1:C,D"]
    },
    {
      "id": "complete-verb",
      "label": "Completar com a forma verbal correta",
      "skill": ["conjugation"],
      "generatable": true, "needs_audio": false,
      "example": { "item": "Ela ___ Teresa.", "verb": "chamar-se", "person": "ela", "answer": "chama-se" },
      "origins": ["caderno:u1:C", "caderno:u2:F"]
    },
    {
      "id": "complete-article",
      "label": "Completar com o / a (onde necessário)",
      "skill": ["article", "gender"],
      "generatable": true, "needs_audio": false,
      "example": { "item": "Ele é ___ Jorge Viegas.", "answer": "o" },
      "note": "Inclui casos de artigo-zero (Marrocos, Angola, nomes sem artigo).",
      "origins": ["caderno:u1:F"]
    },
    {
      "id": "complete-prep",
      "label": "Completar com de/da/do/dos ou em/na/no/nos",
      "skill": ["preposition", "article", "gender"],
      "generatable": true, "needs_audio": false,
      "example": { "item": "Tóquio é ___ Japão.", "answer": "no" },
      "note": "CHAVE: requer conhecer género+artigo do país. Gerar a partir de countries.json.",
      "origins": ["caderno:u2:H"]
    },
    {
      "id": "complete-me-te-se",
      "label": "Completar com me / te / se (pronome reflexo)",
      "skill": ["pronoun", "conjugation"],
      "generatable": true, "needs_audio": false,
      "example": { "item": "Ele chama-___ Rafael.", "answer": "se" },
      "origins": ["caderno:u1:E"]
    },
    {
      "id": "transform",
      "label": "Reescrever (ser -> ficar, singular -> plural)",
      "skill": ["transformation"],
      "generatable": true, "needs_audio": false,
      "example": { "item": "Berlim é na Alemanha.", "op": "ser->ficar", "answer": "Berlim fica na Alemanha." },
      "origins": ["livro:u2:I", "caderno:u2:G"]
    },
    {
      "id": "correct-sentence",
      "label": "Corrigir a frase (com pista)",
      "skill": ["preposition", "knowledge"],
      "generatable": true, "needs_audio": false,
      "example": { "item": "Madonna é de Itália.", "hint": "Estados Unidos", "answer": "Madonna não é de Itália. É dos Estados Unidos." },
      "origins": ["caderno:u2:C"]
    },
    {
      "id": "order-words",
      "label": "Ordenar palavras para formar a frase",
      "skill": ["syntax"],
      "generatable": true, "needs_audio": false,
      "example": { "tokens": ["do","Janeiro","de","somos","Rio"], "answer": "Somos do Rio de Janeiro." },
      "origins": ["caderno:u1:G", "caderno:u2:I"]
    },
    {
      "id": "order-time",
      "label": "Ordenar expressões por critério (tempo)",
      "skill": ["vocab"],
      "generatable": true, "needs_audio": false,
      "example": { "items": ["Até já!","Até amanhã!","Até sábado!"], "criterion": "menos -> mais tempo" },
      "origins": ["livro:u1:K"]
    },
    {
      "id": "number-spell",
      "label": "Escrever números por extenso / fazer contas",
      "skill": ["numbers"],
      "generatable": true, "needs_audio": false,
      "example": { "item": "23 + 52 = ?", "answer": "setenta e cinco", "full": "vinte e três mais cinquenta e dois são setenta e cinco" },
      "origins": ["livro:u1:H", "livro:u2:L", "caderno:u1:J", "caderno:u2:J"]
    },
    {
      "id": "spelling-fill",
      "label": "Completar as letras que faltam",
      "skill": ["spelling"],
      "generatable": true, "needs_audio": false,
      "example": { "item": "S _ B _ _ _", "answer": "sábado" },
      "origins": ["caderno:u1:H", "caderno:u2:B"]
    },
    {
      "id": "sequence-fill",
      "label": "Escrever o termo que falta na sequência",
      "skill": ["vocab", "numbers"],
      "generatable": true, "needs_audio": false,
      "example": { "seq": ["trinta e três","___","noventa e nove"], "answer": "sessenta e seis" },
      "origins": ["caderno:u1:I", "caderno:u2:J"]
    },
    {
      "id": "true-false",
      "label": "Verdadeiro ou falso (factual + gramática)",
      "skill": ["preposition", "knowledge"],
      "generatable": true, "needs_audio": false,
      "example": { "item": "Miami é nos Estados Unidos.", "answer": true },
      "origins": ["livro:u2:G"]
    },
    {
      "id": "pron-underline",
      "label": "Sublinhar sílaba tónica / som específico",
      "skill": ["pronunciation"],
      "generatable": true, "needs_audio": "optional",
      "example": { "item": "domingo", "task": "[u]?", "answer": "doming[u]" },
      "note": "Funciona sem áudio como exercício visual; áudio só reforça.",
      "origins": ["livro:u1:PronB,C,D,E", "livro:u2:PronA-D", "caderno:u1:L,M,N", "caderno:u2:K,L"]
    },
    {
      "id": "listen-and-do",
      "label": "Ouça e ... (repetir / numerar / completar)",
      "skill": ["listening"],
      "generatable": false, "needs_audio": true,
      "note": "OPEN QUESTION: itens atrás do ícone audio (A1..A9). Opções: (a) substituir por TTS pt-PT, (b) converter em leitura/escrita sem áudio, (c) omitir. A maioria tem variante não-áudio equivalente no caderno.",
      "origins": ["livro:u1:A1,A2,A3,A4,A5", "livro:u2:A6,A7,A8,A9"]
    }
  ]
}
