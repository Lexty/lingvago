      "form": "qual",
      "category": "which",
      "gloss_ru": "какой / который",
      "gloss_en": "which",
      "agreement": {
        "number": "sg"
      },
      "note": "Agrees in NUMBER only (singular). Used to identify one of a set: Qual é a sua morada?"
