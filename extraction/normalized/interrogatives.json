  "table": [
    {
      "form": "quem",
      "category": "who",
      "gloss_ru": "кто",
      "gloss_en": "who",
      "agreement": null,
      "note": "Invariable; refers only to people. E.g. Quem é ele?"
    },
    {
      "form": "que",
      "category": "what",
      "gloss_ru": "что / какой (перед существительным)",
      "gloss_en": "what / which (before a noun)",
      "agreement": null,
      "note": "Used directly before a noun: Que instrumento toca? Que horas são? Contrast with standalone o que."
    },
    {
      "form": "o que",
      "category": "what",
      "gloss_ru": "что",
      "gloss_en": "what",
      "agreement": null,
      "note": "Standalone 'what', not followed by a noun; often with é que: O que é que ele toca?"
    },
    {
      "form": "onde",
      "category": "where",
      "gloss_ru": "где",
      "gloss_en": "where",
      "agreement": null,
      "note": "Static location ('where'): Onde é que ele mora? Used with ser/ficar/estar."
    },
    {
      "form": "aonde",
      "category": "where_to",
      "gloss_ru": "куда",
      "gloss_en": "where to",
      "agreement": null,
      "note": "Direction ('where to'), = a + onde; used with movement verbs (ir): Aonde vais?"
    },
    {
      "form": "para onde",
      "category": "where_to",
      "gloss_ru": "куда",
      "gloss_en": "where to",
      "agreement": null,
      "note": "Direction ('where to'), longer-stay/destination sense: Para onde vais? (cf. ir para)."
    },
    {
      "form": "de onde",
      "category": "where_from",
      "gloss_ru": "откуда",
      "gloss_en": "where from",
      "agreement": null,
      "note": "Origin ('where from'), = de + onde: De onde és?"
    },
    {
      "form": "quando",
      "category": "when",
      "gloss_ru": "когда",
      "gloss_en": "when",
      "agreement": null,
      "note": "Invariable; time: Quando é que ele trabalha?"
    },
    {
      "form": "como",
      "category": "how",
      "gloss_ru": "как",
      "gloss_en": "how",
      "agreement": null,
      "note": "Invariable; manner: Como te chamas? Como estás?"
    },
    {
      "form": "porque",
      "category": "why",
      "gloss_ru": "почему",
      "gloss_en": "why",
      "agreement": null,
      "note": "Question 'why' in non-final position: Porque é que não vais? As an answer it means 'because' (Porque tenho de trabalhar)."
    },
    {
      "form": "porquê",
      "category": "why",
      "gloss_ru": "почему",
      "gloss_en": "why",
      "agreement": null,
      "note": "Stressed form 'why' used standalone or sentence-final: Porquê? / Não vais porquê?"
    },
